# Neon pooled connection for the application.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require&connection_limit=1"
# Direct (non-pooled) connection for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require"

# Private Vietnix S3 bucket (required for product photos on Vercel).
# Keep bucket public access blocked. Never use NEXT_PUBLIC_ for credentials.
# S3_ENDPOINT="https://your-s3-endpoint"
# S3_REGION="us-east-1"
# S3_BUCKET="elegant-private-images"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
